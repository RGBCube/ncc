{ lib, ... }:
let
  inherit (lib.lists) head singleton;

  settings = {
    listen_port = 53;
    listen_addrs_ipv6 = singleton "::";

    zones = singleton {
      zone = ".";
      zone_type = "External";

      stores.type = "forward";
      stores.name_servers = singleton {
        ip = "2a07:a8c0::7f:2bf8";
        trust_negative_responses = true;
        connections = [
          {
            protocol.server_name = "dns.nextdns.io";
            protocol.path = "/7f2bf8";
            protocol.type = "h3"; # http3
          }
          {
            protocol.server_name = "dns.nextdns.io";
            protocol.path = "/7f2bf8";
            protocol.type = "https";
          }
          {
            protocol.server_name = "7f2bf8.dns.nextdns.io";
            protocol.type = "quic";
          }
          {
            protocol.server_name = "7f2bf8.dns.nextdns.io";
            protocol.type = "tls";
          }
        ];
      };
    };
  };
in
{
  flake.nixosModules.dns = {
    services.hickory-dns = {
      enable = true;
      inherit settings;
    };

    etc."resolv.conf".text = # nginx
      ''
        # Generated by NixOS/nix-darwin modules, should use the Hickory-DNS forwarder.
        options edns0 trust-ad
        nameserver ${head settings.listen_addrs_ipv6}
      '';
  };

  flake.darwinModules.dns =
    { pkgs, ... }:
    let
      inherit (lib.meta) getExe;

      toml = pkgs.formats.toml { };
      configFile = toml.generate "hickory-dns.toml" settings;

      hickory-dns = pkgs.hickory-dns.overrideAttrs (old: {
        meta = old.meta // {
          platforms = old.meta.platforms ++ lib.platforms.darwin;
        };
      });
    in
    {
      launchd.daemons.hickory-dns = {
        serviceConfig = {
          ProgramArguments = [
            (getExe hickory-dns)
            "--config"
            "${configFile}"
          ];
          KeepAlive = true;
          RunAtLoad = true;
        };
      };

      networking.dns = singleton <| head settings.listen_addrs_ipv6;
    };
}
